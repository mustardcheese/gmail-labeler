# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
#
# `./run.sh` loads `.env` automatically. (A key exported in your shell, or
# saved in ~/.config/gmail-labeler/config.json, works too.) `.env` is
# gitignored; this example file is safe to commit.

# Your model provider's API key. The variable name matches the provider
# (default provider is OpenRouter). See the README "Tuning" section.
OPENROUTER_API_KEY=

# Other providers read their own variable instead, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
